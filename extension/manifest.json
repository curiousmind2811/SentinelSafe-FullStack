{
  "manifest_version": 3,
  "name": "SentinelGraph ZTDL",
  "version": "1.1", 
  "description": "Protects your data from leaking into AI",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://sentinelsafe-fullstack.onrender.com/" 
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://*.openai.com/*"],
      "js": ["content.js"]
    }
  ]
}